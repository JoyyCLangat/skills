{
  "description": "impax-crm guard: blocks secrets in files, commands, and commits; asks before commands that change a Power Platform environment.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-guard.sh\"",
            "timeout": 30,
            "statusMessage": "impax-crm guard"
          }
        ]
      }
    ]
  }
}
